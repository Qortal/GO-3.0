<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">GO 3.0</string>
    <string name="title_activity_main">GO 3.0</string>
    <string name="package_name">com.github.Qortal.qortalGo2</string>
    <string name="custom_url_scheme">com.github.Qortal.qortalGo2</string>
    <!-- Posted when Android stops GO's background connection at its daily time limit. -->
    <string name="go_paused_title">GO paused</string>
    <string name="go_paused_text">Android paused GO\'s background connection. Open GO to reconnect.</string>
    <!-- Same notice when GO itself paused after 6 h off screen on battery. -->
    <string name="go_battery_pause_text">GO paused its background connection after 6 hours on battery to save power. Open GO to reconnect.</string>
    <!-- Status notification when the chat engine is not running (page frozen or closed).
         English fallbacks; the page sends translations through QortalBackground.setLocalizedStrings. -->
    <string name="status_paused_title">Chat paused</string>
    <string name="status_paused_text">Open GO to sync messages.</string>
    <!-- GO is off screen and background sync keeps the chat engine running. -->
    <string name="status_syncing_background">Syncing in the background</string>
    <!-- Own messages that have not left the phone yet. -->
    <plurals name="status_waiting_text">
        <item quantity="one">%d message waiting to send</item>
        <item quantity="other">%d messages waiting to send</item>
    </plurals>
    <!-- Same count, short, after the status on the one-line collapsed notification. -->
    <string name="status_waiting_short">%1$d unsent</string>
    <!-- Share-sheet entries that send what is shared into a group or a DM. -->
    <string name="share_target_groups">GO Groups</string>
    <string name="share_target_directs">GO DMs</string>
    <!-- Share-sheet entry that sends what is shared into Saved Messages (the chat with yourself). -->
    <string name="share_target_self">GO Self-DM</string>
    <!-- A Rev is Torq's story post; the name stays the same in every language. -->
    <string name="share_target_torq_rev" translatable="false">Torq Rev</string>
    <string name="qortal_hce_description">GO payment requests (testing)</string>
    <!-- Voice calls: ringing and in-call notifications (CallNotifications). The page may
         send GO's own language for the call_* texts (QortalCall.setStrings). -->
    <string name="call_channel_ringing_name">Calls</string>
    <string name="call_channel_ringing_description">Incoming voice calls ring with the phone\'s ringtone.</string>
    <string name="call_channel_ongoing_name">Call in progress</string>
    <string name="call_channel_ongoing_description">Shows the voice call while it runs, with Mute and Hang up.</string>
    <string name="call_incoming_title">Incoming call</string>
    <string name="call_incoming_text">GO voice call</string>
    <string name="call_action_accept">Accept</string>
    <string name="call_action_decline">Decline</string>
    <string name="call_action_hang_up">Hang up</string>
    <string name="call_action_leave">Leave</string>
    <string name="call_action_mute">Mute</string>
    <string name="call_action_unmute">Unmute</string>
    <string name="call_status_calling">Calling…</string>
    <string name="call_status_connecting">Connecting…</string>
    <string name="call_status_ongoing">Ongoing call</string>
    <string name="call_status_group">Group call</string>
    <string name="call_status_muted">Muted</string>
    <string name="call_unknown_caller">Unknown caller</string>
</resources>
