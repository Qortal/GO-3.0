<?xml version="1.0" encoding="utf-8"?>
<!-- Capacitor's own layout (capacitor/src/main/res/layout), with GoWebView,
     which lets keyboards insert pictures into the chat composer. App
     resources replace the library's of the same name. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <com.github.Qortal.qortalMobile.GoWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
