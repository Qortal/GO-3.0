<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup="false": no Android Auto Backup of app data to Google
         Drive. dataExtractionRules also blocks phone-to-phone transfer on
         Android 12+ (see res/xml/data_extraction_rules.xml).
         allowCrossUidActivitySwitchFromBelow="false" (Android 15+): another
         app's activity below GO in a task cannot open a screen over GO
         (GO-35, task hijacking). -->
    <application
        android:largeHeap="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:allowCrossUidActivitySwitchFromBelow="false"
        tools:targetApi="35"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation|touchscreen"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="unspecified"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:exported="true">
            <!-- taskAffinity="": GO's screen never joins another app's task,
                 so on Android 8-10 an app cannot slip a fake GO screen into
                 GO's task (GO-35, StrandHogg). singleTask still keeps one GO. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Qortal payment / resource deep links. Lets scanned QR codes and
                 external links such as qortal://pay?recipient=Q...&amount=5 ,
                 qortal://<address> or qort:<address>?amount=5 open Qortal GO. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="qortal" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="qort" />
            </intent-filter>

            <!-- Qortal gateway web links (App Links). Makes Qortal GO appear in
                 Android's "Opening links" list for the QDN gateway hosts and,
                 once each domain hosts /.well-known/assetlinks.json for this
                 app's signing cert, lets verified https links auto-open. The
                 https(s) URL is translated to the equivalent qortal:// deep link
                 in paymentLink.ts (gatewayHttpsToQortalLink) and routed in-app:
                 e.g. https://qortal.link/WEBSITE/REON -> qortal://WEBSITE/REON.
                 NOTE: verification requires the RELEASE signing SHA-256 in the
                 published assetlinks.json (the debug cert differs). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="qortal.link" />
                <data android:host="www.qortal.link" />
                <data android:host="hub.qortal.link" />
                <data android:host="go.qortal.link" />
                <data android:host="ext-node.qortal.link" />
            </intent-filter>
            <!-- Same hosts over http (cleartext). Not autoVerify (App Links
                 verification only applies to https) but still lets plain http
                 gateway links open Qortal GO. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:host="qortal.link" />
                <data android:host="www.qortal.link" />
                <data android:host="hub.qortal.link" />
                <data android:host="go.qortal.link" />
                <data android:host="ext-node.qortal.link" />
            </intent-filter>

        </activity>

        <!-- "Quitter" / "Torq" entry in the Android share sheet: sharing a
             photo or a video from any app opens Qortal GO with the media
             pre-attached in the Home composer. Only one of the two aliases is
             enabled at a time, following the app the composer posts to
             (ShareReceiverPlugin.setShareTarget). They go through
             ShareTrampolineActivity, so disabling one never closes GO. -->
        <activity
            android:name=".ShareTrampolineActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />
        <activity-alias
            android:name=".QuitterShareActivity"
            android:targetActivity=".ShareTrampolineActivity"
            android:label="Quitter"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter android:label="Quitter">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:label="Quitter">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TorqShareActivity"
            android:targetActivity=".ShareTrampolineActivity"
            android:label="Torq"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:label="Torq">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:label="Torq">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity-alias>
        <!-- "Torq Rev": one photo or video opens Torq's Rev editor with it.
             On only while Torq is the composer's app, with "Torq" above. -->
        <activity-alias
            android:name=".TorqRevShareActivity"
            android:targetActivity=".ShareTrampolineActivity"
            android:label="@string/share_target_torq_rev"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:label="@string/share_target_torq_rev">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity-alias>

        <!-- "GO Groups" / "GO DMs" / "GO Self-DM" in the share sheet: text,
             links, photos, videos and files go into a chat. Groups and DMs
             open that list in Q-Chat with the share in its header, and the
             chat tapped there gets it in its composer; Self-DM opens Saved
             Messages with it. No single chats are offered in the share sheet
             or the launcher. Same trampoline as above; always on. -->
        <activity-alias
            android:name=".GroupsShareActivity"
            android:targetActivity=".ShareTrampolineActivity"
            android:label="@string/share_target_groups"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter android:label="@string/share_target_groups">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_groups">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DirectsShareActivity"
            android:targetActivity=".ShareTrampolineActivity"
            android:label="@string/share_target_directs"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter android:label="@string/share_target_directs">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_directs">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".SelfShareActivity"
            android:targetActivity=".ShareTrampolineActivity"
            android:label="@string/share_target_self"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter android:label="@string/share_target_self">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_self">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="ee.forgr.biometric.AuthActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:theme="@style/QortalBiometricAuthTheme"
            tools:replace="android:theme" />

        <activity
            android:name=".QortalBiometricAuthActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:theme="@style/QortalBiometricAuthTheme" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- androidx.emoji2 would ask Google Play Services' font provider for
             an emoji font every time GO starts. GO's text is drawn by the
             WebView, which has its own emoji, so drop that initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <!-- WebView: no usage/crash metrics to Google, and no Safe Browsing
             lookups (a Google service, through Play Services). The WebView
             only shows GO's own pages and Q-Apps from the Qortal node. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!-- Qortal Reticulum / presence foreground service. During a voice
             call it also runs as "microphone" (CallSession / Android 11+
             silences the mic of an app off screen otherwise), with the call
             notification; back to dataSync / remoteMessaging after it. -->
        <service
            android:name=".QortalForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|remoteMessaging|microphone" />

        <!-- Background player: audio and video playing in GO (Q-Apps,
             websites, GO itself) with the player notification and lock
             screen controls. Runs only while something plays (GoMediaHub). -->
        <service
            android:name=".QortalMediaService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The player notification's buttons (Android 12 and older) and its
             swipe-away. Not exported: only GO's own PendingIntents reach it. -->
        <receiver
            android:name=".QortalMediaActionReceiver"
            android:exported="false" />

        <!-- Decline / Hang up / Mute on the call notifications. Not exported:
             only GO's own PendingIntents (explicit component) reach it. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Qortal Card (testing): another GO phone reads this phone's payment
             request by tapping. Only the system's NFC service can bind it
             (BIND_NFC_SERVICE); it answers only while the page has a request
             out, and only on an unlocked phone (res/xml/qortal_hce_service). -->
        <service
            android:name=".QortalHceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/qortal_hce_service" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice calls: WebView getUserMedia mic capture (Capacitor grants the
         WebView audio resource after these runtime permissions are held). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Calls work on phones and tablets without a microphone too (listen only). -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Voice calls on a Bluetooth headset. Android 12+ routes the call with
         setCommunicationDevice, which needs no Bluetooth permission: GO never
         declares or asks for BLUETOOTH_CONNECT (the "Nearby devices" prompt).
         Android 11 and older grant BLUETOOTH at install (SCO audio), no prompt. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Never the "Nearby devices" prompt: these are that group's runtime
         permissions. tools:node="remove" drops them from the merged manifest
         even if a library or Capacitor plugin declares one, so Android can
         never ask for them. Bluetooth call audio needs none of them. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.UWB_RANGING"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RANGING"
        tools:node="remove" />
    <!-- In-app QR scanner: WebView getUserMedia camera capture (Capacitor grants
         the WebView video resource after this runtime permission is held). Uses
         jsQR entirely offline — no Google Play Services / ML Kit. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Qortal Card (testing): APDUs to a contactless card through Android's own
         NFC API, only while the Qortal Card screen waits for a tap. A normal
         permission, granted at install. No NFC intent filters, so no tag opens
         GO by itself. Phones without NFC still install GO. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Never hold ACCESS_MEDIA_LOCATION: without it Android 10+ removes the
         GPS position from photos GO reads through MediaStore and the system
         pickers. tools:node="remove" also drops it if a library declares it
         (the file picker plugin can ask for it). Photos on Android 8/9, or
         from another app's own file provider, can still carry it. -->
    <uses-permission
        android:name="android.permission.ACCESS_MEDIA_LOCATION"
        tools:node="remove" />
    <!-- Foreground service permission for Android 9+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Reticulum / presence foreground service type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- remoteMessaging (Android 14+) has no daily time limit: the status
         service type on Android 14+; dataSync before, and as a fallback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Voice calls (Android 14+): the status service adds the microphone
         type while a call runs, so the mic keeps working off screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Background player (Android 14+): audio and video keep playing with GO
         off screen, with the player notification (QortalMediaService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Approval dialogs hide other apps' overlay windows while GO is in front
         (Window.setHideOverlayWindows, Android 12+), so an overlay cannot
         cover them and trick the user into a tap (GO-29). A normal
         permission: granted at install, the user is never asked. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- In-app updates: lets the app hand a build published to QDN to Android's
         package installer. The installer still asks the user to confirm, and
         Android only offers the app this permission once the user has allowed
         it under "Install unknown apps". -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- "Saved" notifications open the file they announce. Without this,
         Android 11+ hides every viewer from resolveActivity and the tap could
         only ever bring GO up. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- The in-app updater hands its build to the system package
             installer by name (AppUpdatePlugin.systemInstallerPackage);
             this makes that installer visible to the lookup. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:scheme="content"
                android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

</manifest>
